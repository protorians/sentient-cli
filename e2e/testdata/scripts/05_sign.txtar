mkdir project
cd project
mkdir external_modules
exec sh -c 'printf "app = \"demo\"\n" > sentient.config.toml'
exec $SENTIENTS --no-color create module blog-manager
exec $SENTIENTS --no-color pack blog-manager

# TC-022 — `sign keygen` génère la paire Ed25519 (vault fichier, HOME isolé).
exec $SENTIENTS --no-color sign keygen
stdout '✓ Paire de clés Ed25519 générée avec succès'
stdout 'Fingerprint'
exists $HOME/.sentient-cli/signing.enc

# FR-024 — `sign` sans argument affiche le fingerprint.
exec $SENTIENTS --no-color sign
stdout 'Clé de signature du développeur'
stdout 'Fingerprint'

# TC-023 — `sign <module>` signe l'archive et produit un .sig de 64 octets.
exec $SENTIENTS --no-color sign blog-manager
stdout '✓ Archive signée avec succès'
exists .sentients/build/blog-manager-0.1.0.smp.sig
exec sh -c 'wc -c < .sentients/build/blog-manager-0.1.0.smp.sig'
stdout '^[[:space:]]*64[[:space:]]*$'

# TC-024 — `sign verify` accepte une signature valide.
exec $SENTIENTS --no-color sign verify blog-manager
stdout '✓ Signature valide'

# TC-025 — archive modifiée : vérification en échec (exit 12), après re-pack
# pour repartir d'une archive saine.
exec $SENTIENTS --no-color pack blog-manager
exec sh -c 'printf "x" >> .sentients/build/blog-manager-0.1.0.smp'
! exec $SENTIENTS --no-color sign verify blog-manager
stderr 'signature invalide'
exec sh -c '"$SENTIENTS" --no-color sign verify blog-manager >/dev/null 2>&1; echo $?'
stdout '^12$'