# TC-013 — `link` associe un module local à son produit distant (token).
# TC-014 — `unlink` régénère un token UUID local ; `--sync-remote` pousse les
# métadonnées via PUT /api/developer-store/modules/:id avant la déliaison.
mkdir project
cd project
mkdir external_modules
exec sh -c 'printf "[publish]\nauto_audit = false\n" > .sentient-cli.toml'
exec $SENTIENTS --no-color create module blog-manager

env SENTIENT_CLI_CONNECT_EMAIL=dev@example.com
env SENTIENT_CLI_CONNECT_PASSWORD=secret
exec $SENTIENTS --no-color connect
exec $SENTIENTS --no-color publish blog-manager
stdout '✓ Publié avec succès'

# TC-013 — lien (token distant récupéré du manifest, synchronisé par publish).
exec sh -c 'awk -F\" "/\"token\"/{print \$4}" external_modules/blog-manager/manifest.json > remote.token'
exec sh -c '"$SENTIENTS" --no-color link blog-manager "$(cat remote.token)"'
stdout '✓ Module lié avec succès'
stdout 'Distant'
exists .sentients/links.json
exec grep -q '[0-9a-f]' .sentients/links.json
exec grep -q '"token": "[0-9a-f-]' external_modules/blog-manager/manifest.json

# TC-014 — déliaison simple : nouveau token UUID local, liaison distante retirée.
env SENTIENT_CLI_YES=1
exec $SENTIENTS --no-color unlink blog-manager
stdout '✓ Module délié avec succès'
exec grep -q '"token": "[0-9a-f-]' external_modules/blog-manager/manifest.json

# Re-lien (token distant conservé) puis déliaison avec synchronisation distante
# (métadonnées → PUT /api/developer-store/modules/:id).
exec sh -c '"$SENTIENTS" --no-color link blog-manager "$(cat remote.token)"'
exec $SENTIENTS --no-color unlink --sync-remote blog-manager
stdout '✓ Métadonnées synchronisées vers le module distant'
stdout '✓ Module délié avec succès'